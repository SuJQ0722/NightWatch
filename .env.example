# Copy to .env and fill in:  cp .env.example .env      (real environment variables override this file)
# A blank value means "use the default" written next to it. Check everything: python -m nightwatch doctor

# ===================================================================== the agent (not modified by NightWatch)
# Any OpenAI-compatible endpoint works; the experiments use MiMo-V2.6-Flash on OpenRouter (https://openrouter.ai).
# Create an OpenRouter key and set OPENROUTER_API_KEY; AGENT_API_KEY overrides it for other endpoints
# (empty = OPENROUTER_API_KEY for openrouter.ai, else OPENAI_API_KEY).
AGENT_BASE_URL=https://openrouter.ai/api/v1
AGENT_MODEL=xiaomi/mimo-v2.6-flash
OPENROUTER_API_KEY=
AGENT_API_KEY=
AGENT_MAX_TOKENS=1500
AGENT_TEMPERATURE=0.5
AGENT_TOP_P=0.9
# JSON merged into every request body. OpenRouter settings of the experiments: the provider is pinned (no
# fallback to other providers, so every method sees the same serving stack), and reasoning effort is high on OSWorld.
# AGENT_EXTRA_BODY is the OSWorld setting; scripts/run_dynacu.sh uses DYNACU_AGENT_EXTRA_BODY instead.
AGENT_EXTRA_BODY={"provider": {"order": ["xiaomi"], "allow_fallbacks": false}, "reasoning": {"effort": "high"}}
DYNACU_AGENT_EXTRA_BODY={"provider": {"order": ["xiaomi"], "allow_fallbacks": false}}
# 1 = stream (needed for mid-generation interrupts); 0 = plain request (interrupts degrade to invalidation)
AGENT_STREAM=1
AGENT_TIMEOUT=300
# Optional proxy for the agent endpoint only, e.g. socks5h://127.0.0.1:1080
AGENT_PROXY=
# USD per 1M tokens, for the cost column (0 = unknown)
AGENT_PRICE_IN_PER_MTOK=0.14
AGENT_PRICE_OUT_PER_MTOK=0.28

# ===================================================================== System-1 (the event observer)
#   http      perception server (scripts/serve_watcher.sh / serve_system1.sh) holding a decision model   [default]
#             (a method may also name a server directly: system1: "http://127.0.0.1:8711", see configs/base.yaml)
#   d3        vLLM-SR Decision 3.0 in-process (D3_MODEL)
#   jev       hosted Jev 1.14 (OPENROUTER_API_KEY or TYPESAFE_API_KEY)
#   frontier  a large VLM answering in JSON (OBSERVER_* below): equal-budget comparator
#   logprob   OpenAI-compatible server, P(yes) from logprobs (LOGPROB_* below)
#   sim       simulated desktop only
SYSTEM1_BACKEND=http
S1_URL=http://127.0.0.1:8710
S1_PORT=8710
# What the server loads: d3 | intern | jev | frontier | logprob
S1_SERVER_BACKEND=d3
# d3 model: a folder under data/models (d3-mini 4B, d3-lite 0.8B) or a fine-tuned package path
D3_MODEL=d3-mini
D3_DEVICE=auto
# questions per forward pass of the d3 runtime (every question re-encodes the images: keep small on a shared GPU)
D3_BATCH=1
# 1 = shared-vision fast path (images through the vision tower once per request; same numbers as the runtime)
D3_PREFIX=1
D3_LM_BATCH=16
# Intern-Decision size (0.8B | 2B | 4B) or an explicit path
INTERN_DECISION_SIZE=0.8B
INTERN_DECISION_PATH=
# auto = the GPU with the most free memory, else cpu (CPU is ~100x slower: fine for tests, not for timing)
INTERN_DEVICE=auto
INTERN_DTYPE=bfloat16
# GPU index for the server (sets CUDA_VISIBLE_DEVICES)
S1_GPU=
# Python of the System-1 env (default .conda/envs/nightwatch-s1/bin/python); any env with torch + transformers 5.x works
S1_PYTHON=
# Longest image side sent to System-1
S1_MAX_SIDE=1280
S1_TIMEOUT=60
# Total time for one System-1 call including retries (it is on the loop's critical path: fail fast, fall back
# to pixels); after a failure, calls are skipped for S1_COOLDOWN_S
S1_BUDGET_S=8
S1_COOLDOWN_S=3

# hosted Jev
JEV_PROVIDER=openrouter
TYPESAFE_API_KEY=
JEV_MODEL=
# frontier-VLM observer (comparator)
OBSERVER_BASE_URL=https://openrouter.ai/api/v1
OBSERVER_MODEL=
OBSERVER_API_KEY=
# single-token logprob observer (comparator), e.g. vllm serve Qwen/Qwen3.5-4B --enable-prefix-caching --port 8901
LOGPROB_BASE_URL=http://127.0.0.1:8901/v1
LOGPROB_MODEL=Qwen/Qwen3.5-4B
LOGPROB_API_KEY=EMPTY
# simulated System-1 noise (smoke only)
SIM_S1_NOISE=0.08
SIM_S1_FLIP=0.005

# ===================================================================== DynaCU-Bench (AOI)
# AOI's own harness (the Vanilla and AOI arms) routes MiMo through OpenRouter with this provider pin
VLLM_OR_PROVIDER=xiaomi
# Judge for the 7 hybrid / LLM-judged tasks, AOI's rubric. The experiments use Gemini 2.5 Flash on OpenRouter
# (AOI's default gemini-2.0-flash with GEMINI_API_KEY is no longer served). DYNACU_JUDGE_API_KEY defaults to
# OPENROUTER_API_KEY for openrouter.ai.
DYNACU_JUDGE=google/gemini-2.5-flash
DYNACU_JUDGE_BASE_URL=https://openrouter.ai/api/v1
DYNACU_JUDGE_API_KEY=
GEMINI_API_KEY=

# ===================================================================== OSWorld
# Where the Ubuntu VM runs:
#   docker  local container (needs docker daemon access and /dev/kvm; bash scripts/setup_container.sh)
#   ags     Tencent Cloud Agent Sandbox, E2B-compatible: no local docker or KVM, many sandboxes in parallel.
#           The experiments use ags. Setup:
#             1. In the AGS console, create an API key and an OSWorld sandbox tool in a region near this machine.
#             2. Fill E2B_API_KEY, E2B_DOMAIN (<region>.tencentags.com) and AGS_TEMPLATE (the sandbox tool id) below.
#             3. bash scripts/setup_container.sh   (checks the keys, installs the e2b SDK and the AGS provider,
#                boots one sandbox)
#           Workers per method x methods running at once must stay within the account's sandbox quota.
#   aws | azure | ...  OSWorld's other providers (credentials as in third_party/OSWorld/desktop_env/providers/)
OSWORLD_PROVIDER=ags
E2B_API_KEY=
E2B_DOMAIN=
AGS_TEMPLATE=
# sandbox lifetime (s); a run closes its sandboxes on exit
AGS_TIMEOUT=36000
# Sudo password of the template's guest user, also given to the agent: docker-style image "password",
# AWS-style image "osworld-public-evaluation"
AGS_SUDO_PASSWORD=
# Frame stream on AGS: daemon = one capture process in the guest, frames read through /file (~15 ms, 10 Hz);
# jpeg = capture + JPEG in the guest, one /run_python per frame (~0.3 s, ~3 Hz); png = official /screenshot.
# Overridden per experiment by env.osworld.ags_grab
OSWORLD_AGS_GRAB=daemon
# docker only: VM image (default data/vm/Ubuntu.qcow2, from bash scripts/setup_container.sh vm)
OSWORLD_VM_PATH=
# aws only
OSWORLD_REGION=
# OSWorld's guest recording-route updater (auto | check | off). Only its screen recording needs it; NightWatch
# never records through OSWorld, and on some AGS templates the updater aborts the boot
OSWORLD_RECORDING_UPDATE=off
# HF mirror for the VM download (OSWorld honours it too)
HF_ENDPOINT=
# Hugging Face Hub repo of the trained watcher (scripts/setup_env.sh models; default nullptr04/NightWatch-0.8B)
# and a token if it is gated; blank token = the token of `hf auth login`
NIGHTWATCH_MODEL_REPO=
HF_TOKEN=

# ===================================================================== paths
# Defaults: <repo>/data, <repo>/runs, <repo>/third_party/OSWorld
DATA_DIR=
RUNS_DIR=
OSWORLD_DIR=
